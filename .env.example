SECRET_KEY=change-this-in-production-random-string
ADMIN_PASSWORD="change-this-password"

# Set to true only for local development on your own machine.
# Never enable this on a machine reachable by others (e.g. over the school LAN) -
# the Werkzeug debugger allows arbitrary code execution.
FLASK_DEBUG=false

# Wohin die Protokolldatei geschrieben wird. Ohne Angabe: logs/ im
# Projektverzeichnis.
# LOG_DIR=/var/log/challenge-plattform

# Die Adresse, unter der die anderen Geräte den Server erreichen - die, die
# auf der Startseite steht und im QR-Code steckt. Normalerweise findet die
# Anwendung sie selbst; nötig ist der Eintrag in einem Netz ohne Gateway,
# wo sie das nicht kann. Dann sagt sie es beim Start. Nur eine IPv4-Adresse,
# kein Rechnername: Die Handys müssten ihn sonst auflösen können.
# LAN_ADRESSE=192.168.1.50

# Der Port, auf dem die Anwendung läuft. Ohne Angabe: 8000. Nur ändern, wenn
# auf diesem Rechner schon ein anderes Programm Port 8000 belegt.
# PORT=8000
